# PostgreSQL / Supabase Credentials
# Supabase: get these from Project Settings → Database → Connection string
#
# SUPABASE_DB_URL MUST start with "jdbc:" — the driver rejects a bare
# "postgresql://" URL. It is HOST + PORT + DATABASE ONLY (no password in URL).
# A password containing '@' breaks JDBC URL parsing, so keep the password
# in SUPABASE_DB_PASSWORD and the user in SUPABASE_DB_USERNAME.
# Example: jdbc:postgresql://db.<ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=
SUPABASE_DB_USERNAME=
SUPABASE_DB_PASSWORD=

# JWT Secret (Min 256-bit / 32 characters random string)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Storage: "local" or "s3"
STORAGE_TYPE=s3
S3_BUCKET_NAME=
AWS_REGION=auto
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# CORS Whitelist (comma-separated URLs)
CORS_ALLOWED_ORIGINS=http://localhost,http://your-server-ip,https://yourdomain.com